# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Database ---
# Dev default falls back to SQLite if unset; in compose this points at the postgres service.
# DATABASE_URL=postgres://mailtivo:mailtivo@postgres:5432/mailtivo_relay

# --- Body / credential encryption ---
# Mint with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RELAY_FERNET_KEY=
# Optional: set during key rotation; old key remains valid for decryption.
RELAY_FERNET_KEY_OLD=

# --- Auth ---
MAGIC_LINK_TTL_MINUTES=15

# --- Outbound email (defaults to console in dev) ---
DEFAULT_FROM_EMAIL=no-reply@mailtivo.local

# --- Django-Q2 ---
Q_WORKERS=4

# --- API rate limit (defaults: 10/s, 600/min per API key) ---
# API_RATE_LIMIT_PER_SECOND=10
# API_RATE_LIMIT_PER_MINUTE=600

# --- Docker compose database (used by docker-compose.yml) ---
POSTGRES_USER=mailtivo
POSTGRES_PASSWORD=mailtivo
POSTGRES_DB=mailtivo_relay
# Host port for the web service; set to 80/443 behind a TLS proxy.
WEB_PORT=8000

# --- Gunicorn ---
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# --- Prod-only security tightening ---
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=31536000
